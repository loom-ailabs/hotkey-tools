{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "tui",
  "remoteCache": { "enabled": false },
  "globalDependencies": ["pyproject.toml", "uv.lock"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".next/**", "out/**", "dist/**", "!.next/cache/**"]
    },
    "@hotkey-tools/python#build": {
      "outputs": ["dist/**"]
    },
    "@hotkey-tools/python-core#build": {
      "outputs": ["dist/**"]
    },
    "@hotkey-tools/worker#build": {
      "outputs": []
    },
    "check-types": {
      "dependsOn": ["^check-types"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "test": {
      "dependsOn": ["^build"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
