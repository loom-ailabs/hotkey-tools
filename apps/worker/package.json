{
  "name": "@hotkey-tools/worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @hotkey-tools/web build && pnpm exec wrangler d1 migrations apply hotkey-tools --local && wrangler dev --port 8787",
    "build": "tsc --noEmit",
    "check-types": "tsc --noEmit",
    "lint": "oxlint src",
    "test": "vitest run",
    "deploy": "node ../../scripts/check-cloudflare.mjs && pnpm --dir ../web build && wrangler deploy",
    "deploy:dry-run": "wrangler deploy --dry-run --outdir dist"
  },
  "dependencies": {
    "hono": "^4.7.2"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261019.1",
    "@types/node": "^24.0.0",
    "oxlint": "^1.72.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.9",
    "wrangler": "4.151.2"
  }
}
