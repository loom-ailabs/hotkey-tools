{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 100,
  "tabWidth": 2,
  "useTabs": false,
  "semi": true,
  "singleQuote": false,
  "trailingComma": "all",
  "endOfLine": "lf",
  "ignorePatterns": [
    "pnpm-lock.yaml",
    "**/uv.lock",
    "**/pylock.toml",
    "**/next-env.d.ts",
    "**/.venv*/**",
    "**/python_modules/**",
    "**/.wrangler/**",
    "**/.next*/**",
    "**/out/**",
    "**/dist/**"
  ]
}
